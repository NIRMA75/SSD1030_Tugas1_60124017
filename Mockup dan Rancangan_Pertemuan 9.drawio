        <UserObject label="Tahapan Penelitian" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" plantUmlBaseValue="Tahapan Penelitian" id="CQSHEaIWRqG4v_Khl1vR-230">
          <mxCell parent="CQSHEaIWRqG4v_Khl1vR-206" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" vertex="1">
            <mxGeometry height="24" width="148" x="104.5" y="3479" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam handwritten false\nskinparam monochrome false\nskinparam shadowing false\nskinparam rectangleCornerRadius 6\nskinparam defaultFontName \&quot;Segoe UI\&quot;, \&quot;Arial\&quot;, sans-serif\n\ntitle MOCKUP SIAKAD UIN PEKALONGAN - TAHAP 1 (PREDIKSI KELULUSAN)\n\n&#39; ====================================================\n&#39; STYLING PALETTE\n&#39; ====================================================\n!define BG_COLOR #F4F6F9\n!define SIDEBAR_BG #1E293B\n!define CARD_BG #FFFFFF\n!define PRIMARY_BTN #0EA5E9\n!define SUCCESS_ALERT #DEF7EC\n\n&#39; ====================================================\n&#39; BAGIAN 1: FORM INPUT PREDIKSI\n&#39; ====================================================\npackage \&quot;1. Form Input Data Prediksi\&quot; #BG_COLOR {\n  \n  rectangle \&quot;  🎓  SIAKAD UIN Pekalongan\&quot; as Brand1 #SIDEBAR_BG\n  rectangle \&quot; 🧭 Dashboard                                                                    🔔  👤 Ahmad (Mahasiswa) ∨\&quot; as Header1 #CARD_BG\n\n  rectangle \&quot;Card Dashboard\&quot; as CardForm #CARD_BG {\n    rectangle \&quot;🎓 Sistem Prediksi Kelulusan Mahasiswa\&quot; as TitleForm #CARD_BG\n    \n    rectangle \&quot;Nama Mahasiswa\\n[ Masukkan nama lengkap...                                                            ]\&quot; as InNama #CARD_BG\n    rectangle \&quot;IPK (0.0 - 4.0)\\n[ 3.75                                                                                     ⚙️ ]\&quot; as InIPK #CARD_BG\n    rectangle \&quot;Total SKS\\n[ 145                                                                                     ⚙️ ]\&quot; as InSKS #CARD_BG\n    rectangle \&quot; [ 🚀 Prediksi &amp; Simpan Data ➔ ] \&quot; as BtnSubmit #PRIMARY_BTN\n  }\n\n  Brand1 -[hidden]right-&gt; Header1\n  Header1 -[hidden]down-&gt; CardForm\n  TitleForm -[hidden]down-&gt; InNama\n  InNama -[hidden]down-&gt; InIPK\n  InIPK -[hidden]down-&gt; InSKS\n  InSKS -[hidden]down-&gt; BtnSubmit\n}\n\n&#39; ====================================================\n&#39; BAGIAN 2: HASIL PREDIKSI &amp; TABEL RIWAYAT\n&#39; ====================================================\npackage \&quot;2. Hasil Prediksi &amp; Riwayat Data (Database Integration)\&quot; #BG_COLOR {\n  \n  rectangle \&quot;  🎓  SIAKAD UIN Pekalongan\&quot; as Brand2 #SIDEBAR_BG\n  rectangle \&quot; 🧭 Dashboard                                                                    🔔  👤 Ahmad (Mahasiswa) ∨\&quot; as Header2 #CARD_BG\n  \n  rectangle \&quot;🎉 Sukses! Prediksi Mahasiswa \\\&quot;Ahmad\\\&quot; (IPK: 3.75, SKS: 145): LULUS TEPAT WAKTU. Data berhasil disimpan ke database.\&quot; as AlertSuccess #SUCCESS_ALERT\n\n  rectangle \&quot;📊 Riwayat Hasil Prediksi Mahasiswa\\n\\nNo  |  Nama Mahasiswa   |  IPK   |  Total SKS  |  Status Kelulusan    |  Tanggal Input  |  Aksi\\n--------------------------------------------------------------------------------------------------------------------------\\n1   |  Ahmad            |  3.75  |  145        |  Lulus Tepat Waktu   |  2026-10-31     |  [Detail] [Hapus]\\n2   |  Budi Santoso     |  3.20  |  130        |  Lulus Tepat Waktu   |  2026-10-31     |  [Detail] [Hapus]\\n3   |  Siti Rahma       |  2.80  |  120        |  Tidak Lulus         |  2026-10-30     |  [Detail] [Hapus]\\n4   |  Dian Pratama     |  3.85  |  148        |  Lulus Tepat Waktu   |  2026-10-30     |  [Detail] [Hapus]\\n5   |  Eko Wijaya       |  3.10  |  142        |  Lulus Tepat Waktu   |  2026-10-29     |  [Detail] [Hapus]\&quot; as TableData #CARD_BG\n\n  Brand2 -[hidden]right-&gt; Header2\n  Header2 -[hidden]down-&gt; AlertSuccess\n  AlertSuccess -[hidden]down-&gt; TableData\n}\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="amIysFH2voOCmnb22E_u-85">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 0 10 10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

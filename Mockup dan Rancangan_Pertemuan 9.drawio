        <UserObject label="Kerangka Pemikiran dan Tahapan Penelitian" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" plantUmlBaseValue="Kerangka Pemikiran dan Tahapan Penelitian" id="CQSHEaIWRqG4v_Khl1vR-51">
          <mxCell parent="CQSHEaIWRqG4v_Khl1vR-1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" vertex="1">
            <mxGeometry height="24" width="329" x="201.5" y="965" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Kerangka Pemikiran\n\ntop to bottom direction\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam ArrowColor black\nskinparam activity {\n  BackgroundColor white\n  BorderColor black\n  FontColor black\n  BorderThickness 1.3\n  RoundCorner 10\n}\n\nstart\n\n:Permasalahan pengelolaan sampah\nantarkabupaten/kota di Pulau Jawa;\n\n:Pengumpulan data sekunder\n(SIPSN dan BPS);\n\npartition \&quot;Indikator Penelitian\&quot; {\n  fork\n    :C1\n    Timbulan sampah tahunan;\n  fork again\n    :C2\n    Persentase sampah\n    belum terkelola;\n  fork again\n    :C3\n    Kepadatan penduduk;\n  fork again\n    :C4\n    Defisit infrastruktur\n    pengelolaan sampah;\n  end fork\n}\n\n:Pengolahan data\n(pembersihan, penggabungan,\ndan penyusunan matriks keputusan);\n\n:Analisis SAW\n(normalisasi, pembobotan,\nskor, dan peringkat);\n\n:Integrasi dengan data spasial\n(SIG/QGIS);\n\n:Peta tematik dan rekomendasi\nwilayah prioritas pengelolaan sampah;\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CQSHEaIWRqG4v_Khl1vR-172">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="CQSHEaIWRqG4v_Khl1vR-205" parent="CQSHEaIWRqG4v_Khl1vR-172" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="122" width="726.5" x="60.5" y="2991" as="geometry" />
        </mxCell>

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Kerangka Pemikiran dan Tahapan Penelitian\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam activity {\n  BackgroundColor white\n  BorderColor black\n  FontColor black\n  RoundCorner 12\n}\nskinparam ArrowColor black\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\n\n|Kerangka Pemikiran|\nstart\n:Permasalahan pengelolaan sampah\nantarkabupaten/kota di Pulau Jawa;\n\n:Pengumpulan data sekunder\n(SIPSN dan BPS);\n\npartition \&quot;Indikator Penelitian\&quot; {\n  :C1 - Timbulan sampah tahunan;\n  :C2 - Persentase sampah belum terkelola;\n  :C3 - Kepadatan penduduk;\n  :C4 - Defisit infrastruktur pengelolaan sampah;\n}\n\n:Pengolahan data\n(pembersihan, penggabungan,\ndan penyusunan matriks keputusan);\n\n:Analisis SAW\n(normalisasi, pembobotan,\nskor, dan peringkat);\n\n:Integrasi dengan data spasial\n(SIG/QGIS);\n\n:Peta tematik dan rekomendasi\nwilayah prioritas pengelolaan sampah;\nstop\n\n|Tahapan Penelitian|\nstart\n:Identifikasi masalah dan\npenetapan tujuan penelitian;\n\n:Penentuan indikator dan\npemeriksaan ketersediaan data;\n\n:Pengumpulan data\n(SIPSN, BPS, dan batas administrasi);\n\n:Pemeriksaan, pembersihan,\ndan penggabungan data;\n\n:Penyusunan matriks keputusan;\n\n:Analisis deskriptif dan\nperhitungan SAW;\n\n:Pengujian hasil dan\nanalisis sensitivitas;\n\n:Penggabungan hasil dengan data spasial\ndan pembuatan peta tematik;\n\n:Interpretasi hasil dan\npenyusunan rekomendasi;\n\n:Penyusunan laporan penelitian;\nstop\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CQSHEaIWRqG4v_Khl1vR-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
